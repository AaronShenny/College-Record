{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "College Record Maker Tauri",
  "version": "0.2.0",
  "identifier": "edu.rajagiri.collegerecordmaker",
  "build": { "frontendDist": "../../dist/tauri-renderer" },
  "plugins": { "updater": { "pubkey": "", "requireSignedVersion": true } },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../dist/tauri-icon.ico"],
    "resources": { "../../dist/tauri-resources/": "runtime/" },
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
